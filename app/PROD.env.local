# as for Vue CLI 'production' in production mode, 'test' in test mode, and defaults to 'development' otherwise
NODE_ENV=production

# if true, debug logs will be printed in the console
VUE_APP_DEBUG=false

# possible values: 'real' (default) for real API, 'mock' for simulated API
VUE_APP_API=real

# base URL for API calls for tests, used in 'real' mode to test against a local server with invitation code 00
VUE_APP_API_TEST_URL=http://localhost:3000/api

# possible values: 'real' (default), 'mock', 'csv', 'txt'
VUE_APP_GPS=real

# 'real' (default) for real device, 'mock' for simulated
VUE_APP_MOTION=real

# possible values: 'real' (default), 'mock' for simulated, 'none' for nothing
VUE_APP_STEPCOUNTER=real

# possible values: 'real' (default) for app, 'local' for testing in browser
VUE_APP_STORAGE=real

# possible values: 'real' (default) for app, 'localStorage' for browser, 'mock' for nothing
VUE_APP_FILES=real
